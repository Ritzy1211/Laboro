// LABORO - Global Workforce Operating System
// Database Schema - PostgreSQL with Prisma ORM

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum UserRole {
  WORKER
  CLIENT
  ENTERPRISE_ADMIN
  SUPER_ADMIN
}

enum OrganizationType {
  STARTUP
  SMB
  ENTERPRISE
  AGENCY
  GOVERNMENT
}

enum JobStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
  ORGANIZATION
}

enum BudgetType {
  FIXED
  HOURLY
  MILESTONE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MatchStatus {
  SUGGESTED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  PAUSED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum NotificationType {
  EMAIL
  PUSH
  IN_APP
  SMS
}

enum NotificationCategory {
  JOB
  TASK
  PAYMENT
  MESSAGE
  SYSTEM
  MARKETING
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// ============================================
// CORE USER & IDENTITY
// ============================================

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  emailVerified         Boolean               @default(false)
  emailVerifiedAt       DateTime?
  passwordHash          String?
  
  // Profile
  firstName             String
  lastName              String
  displayName           String?
  avatar                String?
  bio                   String?               @db.Text
  phone                 String?
  phoneVerified         Boolean               @default(false)
  
  // Location & Time
  timezone              String                @default("UTC")
  country               String?
  city                  String?
  locale                String                @default("en")
  
  // Status & Role
  status                UserStatus            @default(PENDING_VERIFICATION)
  primaryRole           UserRole              @default(WORKER)
  
  // Worker specific
  hourlyRate            Decimal?              @db.Decimal(10, 2)
  reliabilityScore      Int                   @default(100) // 0-100
  completedJobs         Int                   @default(0)
  totalEarnings         Decimal               @default(0) @db.Decimal(12, 2)
  
  // Client specific
  companyName           String?
  industry              String?
  
  // Security
  twoFactorEnabled      Boolean               @default(false)
  twoFactorSecret       String?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  failedLoginAttempts   Int                   @default(0)
  lockedUntil           DateTime?
  
  // Verification
  identityVerified      VerificationStatus    @default(UNVERIFIED)
  documentVerified      VerificationStatus    @default(UNVERIFIED)
  
  // Preferences
  preferences           Json                  @default("{}")
  
  // Timestamps
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  
  // Relations
  organization          Organization?         @relation(fields: [organizationId], references: [id])
  organizationId        String?
  
  skills                UserSkill[]
  availability          AvailabilityWindow[]
  ownedJobs             Job[]                 @relation("JobOwner")
  assignedJobs          JobAssignment[]
  applications          JobApplication[]
  tasks                 Task[]
  matchesAsWorker       Match[]               @relation("MatchWorker")
  ratingsGiven          Rating[]              @relation("RatingAuthor")
  ratingsReceived       Rating[]              @relation("RatingTarget")
  payments              Payment[]
  notificationSettings  NotificationSetting[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  sessions              Session[]
  apiKeys               ApiKey[]
  socialAccounts        SocialAccount[]
  
  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([primaryRole])
  @@index([timezone])
  @@index([reliabilityScore])
  @@map("users")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token         String    @unique
  refreshToken  String?   @unique
  
  userAgent     String?
  ipAddress     String?
  
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  
  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model SocialAccount {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider        String    // google, github, linkedin
  providerUserId  String
  accessToken     String?   @db.Text
  refreshToken    String?   @db.Text
  expiresAt       DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  keyHash     String    @unique
  keyPrefix   String    // First 8 chars for identification
  
  scopes      String[]  @default([])
  rateLimit   Int       @default(1000) // requests per hour
  
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  
  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ============================================
// ORGANIZATION & MULTI-TENANCY
// ============================================

model Organization {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  
  type            OrganizationType  @default(SMB)
  logo            String?
  website         String?
  description     String?           @db.Text
  
  // Billing
  billingEmail    String?
  taxId           String?
  billingAddress  Json?
  
  // Settings
  settings        Json              @default("{}")
  features        String[]          @default([])
  
  // Limits
  maxUsers        Int               @default(10)
  maxJobsPerMonth Int               @default(50)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  
  // Relations
  members         User[]
  departments     Department[]
  jobs            Job[]
  subscription    Subscription?
  invoices        Invoice[]
  
  @@index([slug])
  @@map("organizations")
}

model Department {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  budget          Decimal?      @db.Decimal(12, 2)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  jobs            Job[]
  
  @@unique([organizationId, name])
  @@map("departments")
}

// ============================================
// SKILLS & EXPERTISE
// ============================================

model Skill {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  category    String
  description String?
  
  // For skill taxonomy
  parentId    String?
  parent      Skill?      @relation("SkillHierarchy", fields: [parentId], references: [id])
  children    Skill[]     @relation("SkillHierarchy")
  
  verified    Boolean     @default(false)
  popularity  Int         @default(0)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  users       UserSkill[]
  jobs        JobSkill[]
  
  @@index([category])
  @@index([slug])
  @@map("skills")
}

model UserSkill {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  proficiencyLevel Int      @default(1) // 1-5
  yearsExperience  Int?
  verified         Boolean  @default(false)
  endorsements     Int      @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, skillId])
  @@map("user_skills")
}

// ============================================
// AVAILABILITY & TIME-ZONE ENGINE
// ============================================

model AvailabilityWindow {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  dayOfWeek   DayOfWeek
  startTime   String      // HH:mm format in user's timezone
  endTime     String      // HH:mm format in user's timezone
  timezone    String      // Stored timezone for this window
  
  // UTC converted times for querying
  startTimeUtc String
  endTimeUtc   String
  
  isRecurring Boolean     @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([userId])
  @@index([dayOfWeek])
  @@index([startTimeUtc, endTimeUtc])
  @@map("availability_windows")
}

model TimeZoneCache {
  id          String    @id @default(cuid())
  timezone    String    @unique
  
  // Precomputed offsets
  currentOffset   Int       // Minutes from UTC
  dstOffset       Int?      // DST offset if applicable
  isDst           Boolean   @default(false)
  
  // Metadata
  countryCode     String?
  abbreviation    String?
  
  updatedAt       DateTime  @updatedAt
  
  @@map("timezone_cache")
}

// ============================================
// JOBS & TASKS
// ============================================

model Job {
  id              String          @id @default(cuid())
  
  // Basic Info
  title           String
  slug            String
  description     String          @db.Text
  shortDescription String?
  
  // Classification
  category        String
  subcategory     String?
  
  // Budget
  budgetType      BudgetType      @default(FIXED)
  budgetAmount    Decimal         @db.Decimal(12, 2)
  budgetCurrency  String          @default("USD")
  budgetMin       Decimal?        @db.Decimal(12, 2)
  budgetMax       Decimal?        @db.Decimal(12, 2)
  
  // Timeline
  startDate       DateTime?
  deadline        DateTime?
  estimatedHours  Int?
  
  // Status & Priority
  status          JobStatus       @default(DRAFT)
  priority        JobPriority     @default(MEDIUM)
  visibility      JobVisibility   @default(PUBLIC)
  
  // Time-zone requirements
  timezone        String?
  requiredOverlapHours Int?       // Minimum overlap hours with client
  preferredWorkingHours Json?     // { start: "09:00", end: "17:00", days: [1,2,3,4,5] }
  
  // Matching
  maxApplicants   Int             @default(50)
  autoMatch       Boolean         @default(false)
  
  // Metrics
  viewCount       Int             @default(0)
  applicationCount Int            @default(0)
  
  // Timestamps
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  
  // Relations
  ownerId         String
  owner           User            @relation("JobOwner", fields: [ownerId], references: [id])
  
  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id])
  
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  
  skills          JobSkill[]
  applications    JobApplication[]
  assignments     JobAssignment[]
  tasks           Task[]
  matches         Match[]
  milestones      Milestone[]
  
  @@unique([ownerId, slug])
  @@index([status])
  @@index([ownerId])
  @@index([organizationId])
  @@index([category])
  @@index([budgetType])
  @@index([visibility])
  @@index([publishedAt])
  @@map("jobs")
}

model JobSkill {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  required    Boolean   @default(true)
  minLevel    Int       @default(1) // 1-5
  
  @@unique([jobId, skillId])
  @@map("job_skills")
}

model JobApplication {
  id              String            @id @default(cuid())
  jobId           String
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId        String
  worker          User              @relation(fields: [workerId], references: [id])
  
  // Application details
  coverLetter     String?           @db.Text
  proposedRate    Decimal?          @db.Decimal(10, 2)
  estimatedHours  Int?
  availability    String?
  
  // Status
  status          ApplicationStatus @default(PENDING)
  
  // Scoring (AI-assisted)
  matchScore      Int?              // 0-100
  skillMatchScore Int?
  availabilityScore Int?
  
  // Timestamps
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  respondedAt     DateTime?
  
  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
  @@index([status])
  @@map("job_applications")
}

model JobAssignment {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User      @relation(fields: [workerId], references: [id])
  
  // Terms
  rate        Decimal   @db.Decimal(10, 2)
  rateType    BudgetType
  
  startDate   DateTime
  endDate     DateTime?
  
  // Status
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([jobId, workerId])
  @@map("job_assignments")
}

model Milestone {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  title       String
  description String?   @db.Text
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime?
  
  status      TaskStatus @default(PENDING)
  completedAt DateTime?
  
  orderIndex  Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  payments    Payment[]
  
  @@index([jobId])
  @@map("milestones")
}

model Task {
  id              String      @id @default(cuid())
  jobId           String
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Parent task for subtasks
  parentId        String?
  parent          Task?       @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks        Task[]      @relation("TaskHierarchy")
  
  // Basic info
  title           String
  description     String?     @db.Text
  
  // Assignment
  assigneeId      String?
  assignee        User?       @relation(fields: [assigneeId], references: [id])
  
  // Status & Priority
  status          TaskStatus  @default(PENDING)
  priority        JobPriority @default(MEDIUM)
  
  // Time tracking
  estimatedHours  Decimal?    @db.Decimal(6, 2)
  actualHours     Decimal?    @db.Decimal(6, 2)
  
  // Dates
  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  
  orderIndex      Int         @default(0)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  comments        TaskComment[]
  timeEntries     TimeEntry[]
  
  @@index([jobId])
  @@index([assigneeId])
  @@index([status])
  @@index([parentId])
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  
  content   String    @db.Text
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([taskId])
  @@map("task_comments")
}

model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  
  hours       Decimal   @db.Decimal(6, 2)
  description String?
  date        DateTime  @db.Date
  
  createdAt   DateTime  @default(now())
  
  @@index([taskId])
  @@index([userId])
  @@index([date])
  @@map("time_entries")
}

// ============================================
// MATCHING ENGINE
// ============================================

model Match {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User        @relation("MatchWorker", fields: [workerId], references: [id])
  
  // Match scoring
  overallScore    Int         // 0-100
  skillScore      Int
  availabilityScore Int
  reliabilityScore Int
  rateScore       Int?
  
  // AI-generated
  matchReason     String?     @db.Text
  
  status          MatchStatus @default(SUGGESTED)
  
  suggestedAt     DateTime    @default(now())
  respondedAt     DateTime?
  expiresAt       DateTime
  
  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
  @@index([status])
  @@index([overallScore])
  @@map("matches")
}

// ============================================
// RATINGS & REPUTATION
// ============================================

model Rating {
  id          String    @id @default(cuid())
  
  authorId    String
  author      User      @relation("RatingAuthor", fields: [authorId], references: [id])
  targetId    String
  target      User      @relation("RatingTarget", fields: [targetId], references: [id])
  
  jobId       String?
  
  // Ratings (1-5)
  overall     Int
  quality     Int?
  communication Int?
  timeliness  Int?
  professionalism Int?
  
  review      String?   @db.Text
  
  isPublic    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([authorId, targetId, jobId])
  @@index([targetId])
  @@index([overall])
  @@map("ratings")
}

// ============================================
// PAYMENTS & BILLING
// ============================================

model Payment {
  id              String        @id @default(cuid())
  
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  milestoneId     String?
  milestone       Milestone?    @relation(fields: [milestoneId], references: [id])
  
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  
  // Amount
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  
  // Fees
  platformFee     Decimal?      @db.Decimal(10, 2)
  processingFee   Decimal?      @db.Decimal(10, 2)
  netAmount       Decimal?      @db.Decimal(12, 2)
  
  // Status
  status          PaymentStatus @default(PENDING)
  
  // Provider
  provider        String?       // stripe, paypal, etc.
  providerPaymentId String?
  
  // Timestamps
  initiatedAt     DateTime      @default(now())
  processedAt     DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  
  failureReason   String?
  
  @@index([userId])
  @@index([status])
  @@index([milestoneId])
  @@map("payments")
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  
  // Amount
  subtotal        Decimal       @db.Decimal(12, 2)
  tax             Decimal?      @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  
  // Status
  status          InvoiceStatus @default(DRAFT)
  
  // Dates
  issuedAt        DateTime?
  dueDate         DateTime?
  paidAt          DateTime?
  
  // Details
  lineItems       Json          @default("[]")
  notes           String?       @db.Text
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  payments        Payment[]
  
  @@index([organizationId])
  @@index([status])
  @@map("invoices")
}

model Subscription {
  id              String            @id @default(cuid())
  
  organizationId  String            @unique
  organization    Organization      @relation(fields: [organizationId], references: [id])
  
  plan            SubscriptionPlan  @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  
  // Billing
  pricePerMonth   Decimal?          @db.Decimal(10, 2)
  currency        String            @default("USD")
  
  // Provider
  provider        String?           // stripe
  providerSubId   String?
  providerCustId  String?
  
  // Dates
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAt           DateTime?
  cancelledAt        DateTime?
  trialEnd           DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([status])
  @@map("subscriptions")
}

// ============================================
// NOTIFICATIONS
// ============================================

model NotificationSetting {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  category    NotificationCategory
  type        NotificationType
  enabled     Boolean             @default(true)
  
  @@unique([userId, category, type])
  @@map("notification_settings")
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        NotificationType
  category    NotificationCategory
  
  title       String
  body        String              @db.Text
  data        Json?
  
  read        Boolean             @default(false)
  readAt      DateTime?
  
  // For emails
  sentAt      DateTime?
  
  createdAt   DateTime            @default(now())
  
  @@index([userId])
  @@index([read])
  @@index([category])
  @@map("notifications")
}

// ============================================
// AUDIT & COMPLIANCE
// ============================================

model AuditLog {
  id          String      @id @default(cuid())
  
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  
  action      AuditAction
  resource    String      // e.g., "user", "job", "payment"
  resourceId  String?
  
  // Request details
  ipAddress   String?
  userAgent   String?
  
  // Changes
  oldValues   Json?
  newValues   Json?
  
  // Metadata
  metadata    Json?
  
  createdAt   DateTime    @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// GDPR & DATA MANAGEMENT
// ============================================

model DataExportRequest {
  id          String    @id @default(cuid())
  userId      String
  
  status      String    @default("pending") // pending, processing, completed, failed
  
  downloadUrl String?
  expiresAt   DateTime?
  
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  
  @@index([userId])
  @@map("data_export_requests")
}

model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  email       String
  
  reason      String?   @db.Text
  
  status      String    @default("pending") // pending, processing, completed
  
  requestedAt DateTime  @default(now())
  scheduledAt DateTime
  completedAt DateTime?
  
  @@index([userId])
  @@index([status])
  @@map("data_deletion_requests")
}
